# Lakehouse Weather environment
TZ=America/New_York

# Synology host paths. Change to the final shared-folder location before deployment.
LAKEHOUSE_ROOT=/volume1/docker/lakehouse-weather

# Local dashboard port. Remote access should terminate through Tailscale and/or Cloudflare.
HTTP_PORT=8088

# RTL-SDR selection. Prefer a stable EEPROM serial once the dongle is identified.
RTLSDR_SERIAL=00000001
RTL433_FREQUENCY=915M

# Sensor IDs are intentionally blank until Gate 1 discovers them.
WH65B_SENSOR_ID=
WH32B_SENSOR_ID=

# Optional Cloudflare profile. Do not commit a real token.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional dashboard identity
STATION_NAME=Lakehouse Weather
STATION_LATITUDE=
STATION_LONGITUDE=
STATION_ALTITUDE_FT=
