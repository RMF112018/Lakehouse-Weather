# Values used when initializing WeeWX. This is documentation/config seed only;
# the authoritative runtime file is runtime/weewx/weewx.conf generated by WeeWX.

[Station]
    location = Lakehouse Weather
    latitude = <SET_ME>
    longitude = <SET_ME>
    altitude = <SET_ME>, foot
    station_type = SDR

[StdArchive]
    archive_interval = 300
    record_generation = software

[StdConvert]
    target_unit = US
